{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "MigrateOnStartup": false
  },
  "Keycloak": {
    "realm": "techworkhub",
    "auth-server-url": "https://keycloak.invalid/",
    "ssl-required": "external",
    "resource": "techworkhub-api",
    "verify-token-audience": true
  }
}
