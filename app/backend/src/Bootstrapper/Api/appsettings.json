{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "MigrateOnStartup": false
  },
  "Keycloak": {
    "realm": "techworkhub",
    "auth-server-url": "http://localhost:8080/",
    "ssl-required": "none",
    "resource": "techworkhub-api",
    "verify-token-audience": false
  }
}
