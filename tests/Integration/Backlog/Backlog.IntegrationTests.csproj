<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Integration.Backlog</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="8.0.11" />
    <PackageReference Include="Carter" Version="8.2.1" />
    <PackageReference Include="FluentValidation" Version="11.11.0" />
    <PackageReference Include="MediatR" Version="12.4.1" />
  </ItemGroup>

  <!-- El módulo Backlog aún no expone Program/.csproj (DEF-06): se hospedan en memoria las fuentes reales bajo prueba. -->
  <ItemGroup>
    <Compile Include="..\..\..\src\Modules\Backlog\Domain\**\*.cs" Link="Src\Domain\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\..\src\Modules\Backlog\Features\BacklogItems\CreateBacklogItem\*.cs" Link="Src\CreateBacklogItem\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
