<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Unit.Backlog</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
    <PackageReference Include="FluentValidation" Version="11.11.0" />
    <PackageReference Include="MediatR" Version="12.4.1" />
  </ItemGroup>

  <!-- El módulo Backlog no expone .csproj: se compilan solo las fuentes puras (sin EF/Carter) bajo prueba. -->
  <ItemGroup>
    <Compile Include="..\..\..\src\Modules\Backlog\Domain\**\*.cs" Link="Src\Domain\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\..\src\Modules\Backlog\Features\BacklogItems\CreateBacklogItem\CreateBacklogItemCommand.cs" Link="Src\CreateBacklogItemCommand.cs" />
    <Compile Include="..\..\..\src\Modules\Backlog\Features\BacklogItems\CreateBacklogItem\CreateBacklogItemCommandHandler.cs" Link="Src\CreateBacklogItemCommandHandler.cs" />
    <Compile Include="..\..\..\src\Modules\Backlog\Features\BacklogItems\CreateBacklogItem\CreateBacklogItemValidator.cs" Link="Src\CreateBacklogItemValidator.cs" />
  </ItemGroup>

</Project>
